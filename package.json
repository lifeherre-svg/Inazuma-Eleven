{
  "name": "ultimate-legends-futbol-rpg",
  "version": "1.1.0",
  "description": "Ultimate Legends – RPG de fútbol con exploración, colección y partidos en tiempo real (HTML5, sin dependencias).",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node tools/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node tools/validate-data.js",
    "e2e": "node tools/e2e.js",
    "e2e:touch": "node tools/e2e-touch.js",
    "audit": "node tools/responsive-audit.js",
    "apk": "cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../dist/UltimateLegends.apk"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
